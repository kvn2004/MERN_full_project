{
  "version": 3,
  "builds": [
    { "src": "backend/server.ts", "use": "@vercel/node" },
    { "src": "frontend/CareHer/package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "backend/server.ts" },
    { "src": "/(.*)", "dest": "frontend/CareHer/index.html" }
  ]
}
